<main>
  <p><a href="/decks/{{deck._id}}">&larr; Back to {{deck.name}}</a></p>
  <div class="card-note">
    {{#if card.imageUrl}}
      <img class="card-note__image" src="{{card.imageUrl}}" alt="{{card.name}}" />
    {{/if}}
    <div class="card-note__form">
      <h1>{{card.name}}</h1>
      <p class="deck-meta">{{card.manaCost}} &middot; {{card.typeLine}} &middot; {{card.quantity}} in deck</p>
      <form action="/decks/{{deck._id}}/cards/{{card.scryfallId}}/note" method="POST">
        {{#if noteError}}<p class="error-message" role="alert">{{noteError}}</p>{{/if}}
        <label for="note">Your note (only you can see this)</label>
        <textarea name="note" id="note" rows="8" class="form-input" maxlength="{{noteMax}}">{{card.note}}</textarea>
        <button type="submit" class="submit-button">Save note</button>
      </form>
      <form action="/decks/{{deck._id}}/cards/{{card.scryfallId}}/proxies" method="POST">
        {{#if proxyError}}<p class="error-message" role="alert">{{proxyError}}</p>{{/if}}
        <label for="proxies">Proxies among your {{card.quantity}} (only you can see this)</label>
        <input type="number" name="proxies" id="proxies" class="form-input" min="0" max="{{card.quantity}}" value="{{card.proxies}}" required />
        <button type="submit" class="submit-button">Save proxies</button>
      </form>
    </div>
  </div>
</main>
