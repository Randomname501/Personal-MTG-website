<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Archivo:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  </head>
  <body>
    <header>
      <div class="header_title_div">
        <h1 class="header_title"> {{{headerTitle}}}</h1>
      </div>
      <div class="header_nav_links">
        <ul id="header_link_list">
          {{#each navLink}}
            <li><a href={{{link}}}> {{{text}}}</a></li>
          {{/each}}
        </ul>
      </div>    </header>
    {{{body}}}
    <script src="/js/password-toggle.js"></script>
    <script src="/js/opponent-fields.js"></script>

    {{!--
      Vercel Speed Insights and Web Analytics, following the "html" path in the
      Vercel docs — the right fit here because this app is server-rendered
      Handlebars with no bundler, so the npm packages' bare imports can't be
      resolved in the browser.

      The queue shims must run before the scripts load: events fired during page
      load are pushed onto window.siq / window.vaq and drained once the real
      script arrives. Both scripts are first-party paths served by Vercel — they
      only exist on a deployed Vercel build and 404 locally, which is expected.

      Both features must be enabled in the Vercel dashboard for these routes to
      be created. See:
        https://vercel.com/docs/speed-insights/quickstart?framework=html
        https://vercel.com/docs/analytics/quickstart?framework=html
    --}}
    <script>
      window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/speed-insights/script.js"></script>
    <script defer src="/_vercel/insights/script.js"></script>
  </body>
</html>