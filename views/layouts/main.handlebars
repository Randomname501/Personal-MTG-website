<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Archivo:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  </head>
  <body>
    <header>
      <div class="header_title_div">
        <h1 class="header_title"> {{{headerTitle}}}</h1>
      </div>
      <div class="header_nav_links">
        <ul id="header_link_list">
          {{#each navLink}}
            <li><a href={{{link}}}> {{{text}}}</a></li>
          {{/each}}
        </ul>
      </div>    </header>
    {{{body}}}
    <script src="/js/password-toggle.js"></script>
    <script src="/js/opponent-fields.js"></script>
  </body>
</html>