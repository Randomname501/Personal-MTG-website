<main>
  <p><a href="/dashboard">&larr; Back to dashboard</a></p>
  <header class="deck-hero">
    {{#if deck.commanderImageUrl}}
      <div class="deck-hero__commanders">
        <img class="deck-hero__commander" src="{{deck.commanderImageUrl}}" alt="{{deck.commander}}" />
        {{#if deck.partnerImageUrl}}<img class="deck-hero__commander" src="{{deck.partnerImageUrl}}" alt="{{deck.partner}}" />{{/if}}
      </div>
    {{/if}}
    <div class="deck-hero__info">
      <h1>{{deck.name}}</h1>
      <p class="deck-meta">
        By <a href="{{profilePath deck.owner.username}}">{{deck.owner.username}}</a> &middot;
        {{deck.format}}{{#if deck.commander}} &middot; {{deck.commander}}{{#if deck.partner}} &amp; {{deck.partner}}{{/if}}{{/if}}{{#if deck.archetype}} &middot; {{deck.archetype}}{{/if}}{{#if deck.colors.length}} &middot; {{#each deck.colors}}{{this}} {{/each}}{{/if}}
      </p>
      {{#if deck.description}}<p class="deck-hero__desc">{{deck.description}}</p>{{/if}}
      <div class="deck-hero__actions">
        {{#if isOwner}}
          <a href="/decks/{{deck._id}}/cards" class="button">Manage Cards</a>
          <form action="/decks/{{deck._id}}/visibility" method="POST" style="display:inline">
            <select name="visibility" aria-label="Deck visibility">
              <option value="public"{{#if (eq deck.visibility "public")}} selected{{/if}}>Public</option>
              <option value="friends"{{#if (eq deck.visibility "friends")}} selected{{/if}}>Friends</option>
              <option value="private"{{#if (eq deck.visibility "private")}} selected{{/if}}>Private</option>
            </select>
            <button type="submit" class="button">Set visibility</button>
          </form>
        {{else}}
          {{#if isTracked}}
            <form action="/decks/{{deck._id}}/untrack" method="POST" style="display:inline">
              <input type="hidden" name="back" value="/decks/{{deck._id}}" />
              <button type="submit" class="button cancel-button">Untrack</button>
            </form>
          {{else}}
            <form action="/decks/{{deck._id}}/track" method="POST" style="display:inline">
              <input type="hidden" name="back" value="/decks/{{deck._id}}" />
              <button type="submit" class="button">Track</button>
            </form>
          {{/if}}
        {{/if}}
      </div>
    </div>
  </header>

  {{#if assistantEnabled}}
    <section id="deck-assistant" class="deck-assistant" data-deck-id="{{deck._id}}">
      <h2>Deck helper</h2>
      <p class="deck-assistant__hint">Ask for cards in plain English, like "cheap ramp under $2" or "more card draw".</p>
      <div class="deck-assistant__log" aria-live="polite"></div>
      <form class="deck-assistant__form">
        <div class="form-group">
          <label for="deck-assistant-question">Your question</label>
          <input id="deck-assistant-question" name="question" type="text" maxlength="1000" required autocomplete="off" />
        </div>
        <button type="submit" class="button">Ask</button>
      </form>
    </section>
    <script src="/js/deck-assistant.js" defer></script>
  {{/if}}

  <section class="deck-cards-view">
    <div class="deck-cards-view__head">
      <h2>Cards ({{cardCount}})</h2>
      <p class="group-toggle">Sort by:
        <a href="?group=type&amp;dir={{sortDir}}"{{#if (eq groupMode "type")}} aria-current="true"{{/if}}>Type</a> &middot;
        <a href="?group=cmc&amp;dir={{sortDir}}"{{#if (eq groupMode "cmc")}} aria-current="true"{{/if}}>Mana value</a> &middot;
        <a href="?group=color&amp;dir={{sortDir}}"{{#if (eq groupMode "color")}} aria-current="true"{{/if}}>Color</a> &middot;
        <a href="?group=name&amp;dir={{sortDir}}"{{#if (eq groupMode "name")}} aria-current="true"{{/if}}>Name</a>
      </p>
      <p class="group-toggle">Order:
        <a href="?group={{groupMode}}&amp;dir=asc"{{#if (eq sortDir "asc")}} aria-current="true"{{/if}}>Ascending</a> &middot;
        <a href="?group={{groupMode}}&amp;dir=desc"{{#if (eq sortDir "desc")}} aria-current="true"{{/if}}>Descending</a>
      </p>
    </div>
    {{#if cardGroups.length}}
      {{> decklist groups=cardGroups deckId=deck._id linkNotes=isOwner showProxies=isOwner}}
    {{/if}}
    {{#unless deck.cards.length}}
      <p>No cards in this deck yet.{{#if isOwner}} <a href="/decks/{{deck._id}}/cards">Add some</a>.{{/if}}</p>
    {{/unless}}
    {{#if exportText}}
      <details class="deck-import">
        <summary>Export decklist</summary>
        <textarea id="deck-export-text" rows="10" class="form-input" aria-label="Decklist as text" readonly>{{exportText}}</textarea>
        <button type="button" id="deck-export-copy" class="button">Copy</button>
        <a href="/decks/{{deck._id}}/export" class="button">Download</a>
      </details>
    {{/if}}
  </section>
  <script src="/js/deck-export.js" defer></script>

  {{#if consideringGroups.length}}
    <section class="deck-cards-view">
      <h2>Considering</h2>
      {{> decklist groups=consideringGroups deckId=deck._id}}
    </section>
  {{/if}}

  <section class="deck-stats">
    <h2>Record</h2>
    {{#if stats.total}}
      <p class="big-winrate">{{stats.winRate}}% win rate <span>({{stats.wins}}&ndash;{{stats.losses}}&ndash;{{stats.draws}})</span></p>
      <div class="bar-row">
        <span class="bar-label">Wins</span>
        <span class="bar"><span class="bar__fill bar__fill--win" style="width: {{percent stats.wins stats.total}}%"></span></span>
        <span class="bar-val">{{stats.wins}}</span>
      </div>
      <div class="bar-row">
        <span class="bar-label">Losses</span>
        <span class="bar"><span class="bar__fill bar__fill--loss" style="width: {{percent stats.losses stats.total}}%"></span></span>
        <span class="bar-val">{{stats.losses}}</span>
      </div>
      <div class="bar-row">
        <span class="bar-label">Draws</span>
        <span class="bar"><span class="bar__fill bar__fill--draw" style="width: {{percent stats.draws stats.total}}%"></span></span>
        <span class="bar-val">{{stats.draws}}</span>
      </div>
    {{else}}
      <p>No games logged for this deck yet.</p>
    {{/if}}
  </section>

  {{#if stats.matchups.length}}
    <section class="deck-stats">
      <h2>Matchups</h2>
      <p class="matchup-note">One row per opponent deck faced &mdash; a multiplayer game counts once per opponent, so these totals can add up to more than your games played.</p>
      <table class="matchup-table">
        <thead>
          <tr><th>Opponent</th><th>W&ndash;L&ndash;D</th><th>Win rate</th></tr>
        </thead>
        <tbody>
          {{#each stats.matchups}}
            <tr>
              <td>{{this.opponent}}</td>
              <td>{{this.wins}}&ndash;{{this.losses}}&ndash;{{this.draws}}</td>
              <td>
                <span class="bar bar--inline"><span class="bar__fill bar__fill--win" style="width: {{this.winRate}}%"></span></span>
                {{this.winRate}}%
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </section>
  {{/if}}

  {{#if stats.trend.length}}
    <section class="deck-stats">
      <h2>Weekly win rate</h2>
      {{#each stats.trend}}
        <div class="bar-row">
          <span class="bar-label">{{this.week}}</span>
          <span class="bar"><span class="bar__fill bar__fill--win" style="width: {{this.winRate}}%"></span></span>
          <span class="bar-val">{{this.winRate}}% ({{this.games}})</span>
        </div>
      {{/each}}
    </section>
  {{/if}}

  {{#if deck.cards.length}}
    <section class="deck-breakdown">
      <h2>Card breakdown</h2>
      <div class="breakdown-groups">
        <div class="breakdown-group">
          <h3>Mana curve</h3>
          {{#each insights.manaCurve}}
            <div class="bar-row">
              <span class="bar-label">{{this.bucket}}</span>
              <span class="bar"><span class="bar__fill bar__fill--count" style="width: {{this.pct}}%"></span></span>
              <span class="bar-val">{{this.count}}</span>
            </div>
          {{/each}}
        </div>
        <div class="breakdown-group">
          <h3>Colors</h3>
          {{#each insights.colors}}
            <div class="bar-row">
              <span class="bar-label">{{this.color}}</span>
              <span class="bar"><span class="bar__fill bar__fill--mana-{{this.color}}" style="width: {{this.pct}}%"></span></span>
              <span class="bar-val">{{this.count}}</span>
            </div>
          {{/each}}
        </div>
        <div class="breakdown-group">
          <h3>Types</h3>
          {{#each insights.types}}
            <div class="bar-row">
              <span class="bar-label">{{this.type}}</span>
              <span class="bar"><span class="bar__fill bar__fill--count" style="width: {{this.pct}}%"></span></span>
              <span class="bar-val">{{this.count}}</span>
            </div>
          {{/each}}
        </div>
      </div>
    </section>
  {{/if}}
</main>
